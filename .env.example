API_PORT=8002
WEB_PORT=3002
DOCKER_NETWORK=siscont-erp_default

POSTGRES_CONTAINER=siscont_db
POSTGRES_ADMIN_USER=postgres
QHELPDESK_DB_NAME=helpdesk
QHELPDESK_DB_USER=helpdesk
QHELPDESK_DB_PASSWORD=change_this_database_password

# Cambia siscont_db/redis si tus contenedores tienen otros nombres en la red Docker.
DATABASE_URL=postgresql://helpdesk:change_this_database_password@siscont_db:5432/helpdesk
REDIS_URL=redis://redis:6379

SECRET_KEY=change_this_access_secret
REFRESH_SECRET_KEY=change_this_refresh_secret

ALLOWED_ORIGINS=["https://tu-dominio.com"]
